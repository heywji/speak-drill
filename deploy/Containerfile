# speak-drill 服务器版：faster-whisper 识别 + Kokoro 领读（macOS 上的 mlx / say 在 Linux 用不了）
# 构建：podman build -t localhost/speak-drill:latest -f deploy/Containerfile .
# 数据全在 /data（HOME 也指过去）：录音 recordings/、Whisper 模型 .cache/huggingface、Kokoro 模型和 Seeing Speech 视频 .cache/speak-drill
FROM docker.io/library/python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.12

WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY speak_drill ./speak_drill
COPY drills ./drills
RUN uv sync --frozen --no-dev

ENV HOME=/data PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["speak-drill", "gui", "--host", "0.0.0.0", "--port", "8080", "--no-browser", "--drills", "/app/drills", "--out", "/data/recordings"]
